{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/manutej/stalks-and-sections/docs/examples/sheaf.schema.json",
  "title": "SheafGraph JSON",
  "description": "Portable cellular sheaf. Sections and maps are data. Do not Gaussian-fill on import.",
  "type": "object",
  "required": ["id", "title", "levels", "nodes", "edges"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "kicker": { "type": "string" },
    "blurb": { "type": "string" },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "integer", "minimum": 0 },
          "code": { "type": "string" },
          "label": { "type": "string" },
          "kicker": { "type": "string" },
          "blurb": { "type": "string" }
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "level", "dim"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "level": { "type": "integer", "minimum": 0 },
          "dim": { "type": "integer", "minimum": 1, "maximum": 64 },
          "known": { "type": "boolean" },
          "section": {
            "type": "array",
            "items": { "type": "number" }
          },
          "summary": { "type": "string" },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": { "type": "string" },
          "restrictKind": {
            "type": "string",
            "enum": ["identity", "projection", "embed", "spectral", "type-aware"]
          },
          "edgeDim": { "type": "integer", "minimum": 1 },
          "Fsrc": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" } }
          },
          "Ftgt": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "number" } }
          },
          "translation": {
            "type": "array",
            "items": { "type": "number" }
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
